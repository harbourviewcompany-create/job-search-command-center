# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Required server-only key. Protected writes use this after operator authorization
# because anon/authenticated database roles are read-only under migration 010.
# Never expose this through NEXT_PUBLIC_* variables or client-side code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase-session operator allowlist. A valid session is privileged only
# when its user ID or normalized email matches one of these values.
OPERATOR_USER_ID=
OPERATOR_EMAIL=

# Single-user operator authorization
# Required when Supabase Auth is not wired. This key protects job creation,
# imports, status changes, rescoring, settings, contacts, packages, outreach,
# and manual provider pulls.
# Generate a long random value; do not expose it through NEXT_PUBLIC_* variables.
# The same value must be configured as a Supabase Edge Function secret and
# stored in Vault as job_pull_auth_key for the scheduled pull.
JOB_PULL_API_KEY=
# Optional independent HMAC signing key for the HttpOnly browser-access cookie.
# When omitted, JOB_PULL_API_KEY signs the cookie.
JOB_PULL_SESSION_SECRET=

# Job pull — Adzuna (primary, free official API)
# Register at https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional legacy Indeed Publisher ID (public search API is largely restricted)
INDEED_PUBLISHER_ID=

# Optional — AI polish later
ANTHROPIC_API_KEY=
APOLLO_API_KEY=

# Gmail OAuth (Phase 3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/gmail/callback

ZIPRECRUITER_API_KEY=
