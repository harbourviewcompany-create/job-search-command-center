# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Required server-only key. Protected writes use this after operator authorization
# because browser database roles are read-only under migration 010.
# Never expose this through NEXT_PUBLIC_* variables or client-side code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Single-user operator authorization
# Required when Supabase Auth is not wired. This key protects job creation,
# imports, status changes, rescoring, settings, contacts, packages, outreach,
# and manual Job Discovery V2 runs.
# Generate a long random value; do not expose it through NEXT_PUBLIC_* variables.
JOB_PULL_API_KEY=
# Optional independent HMAC signing key for the HttpOnly browser-access cookie.
# When omitted, JOB_PULL_API_KEY signs the cookie.
JOB_PULL_SESSION_SECRET=

# Job Discovery V2 — Adzuna aggregator queries
# Register at https://developer.adzuna.com/signup. The discovery engine applies
# configurable minute/day budgets and preserves a manual-run reserve.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Direct Greenhouse, Lever, Ashby, and SmartRecruiters feeds use public board
# identifiers stored in company_job_sources; no provider API secrets are needed.

# Optional legacy Indeed Publisher ID. New discovery work does not depend on it.
INDEED_PUBLISHER_ID=

# Optional — AI polish later
ANTHROPIC_API_KEY=
APOLLO_API_KEY=

# Gmail OAuth (Phase 3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/gmail/callback

ZIPRECRUITER_API_KEY=
